# Required: Anthropic API key for the Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-...

# Optional: passphrase used to encrypt/decrypt the Playwright storage_state.
# If unset, the CLI will prompt for it on each run.
SESSION_PASSPHRASE=

# Optional: override defaults
QA_INTRANET_BASE_URL=https://intranettools.esic.edu/informes/encuestas
QA_INTRANET_MODEL=claude-sonnet-4-6

# Optional: use the OS-installed Edge/Chrome instead of the bundled Chromium.
# Needed when Azure AD Conditional Access blocks the unmanaged Chromium.
# Values: msedge | chrome | (empty for bundled Chromium)
QA_INTRANET_BROWSER=msedge
